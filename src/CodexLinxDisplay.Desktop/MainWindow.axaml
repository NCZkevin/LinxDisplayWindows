<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:CodexLinxDisplay.Desktop"
        x:Class="CodexLinxDisplay.Desktop.MainWindow"
        x:DataType="local:MainViewModel"
        Title="Codex 屏显 for Linx68"
        Icon="avares://CodexLinxDisplay/Assets/app-icon.png"
        Width="920" Height="720" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">
    <Border Grid.Row="0" Padding="24,18" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
      <StackPanel>
        <TextBlock Text="Codex 屏显 for Linx68" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="跨平台预览版 · Windows / macOS / Linux" Opacity="0.62" Margin="0,3,0,0" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,240" ColumnSpacing="24" Margin="24,20,24,12">
      <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Classes="section">
            <StackPanel Spacing="10">
              <TextBlock Classes="sectionTitle" Text="显示内容" />
              <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="模式" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="卡片样式" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="section" IsVisible="{Binding IsPomodoroMode}">
            <StackPanel Spacing="10">
              <TextBlock Classes="sectionTitle" Text="番茄钟" />
              <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="9">
                <TextBlock Grid.Row="0" Text="当前任务" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TaskName}" MaxLength="24" />
                <TextBlock Grid.Row="1" Text="专注时长" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding FocusMinutes}" Minimum="1" Maximum="120" FormatString="0 分钟" />
                <TextBlock Grid.Row="2" Text="短休息" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding ShortBreakMinutes}" Minimum="1" Maximum="60" FormatString="0 分钟" />
                <TextBlock Grid.Row="3" Text="长休息" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding LongBreakMinutes}" Minimum="1" Maximum="120" FormatString="0 分钟" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <Button Classes="primary" Content="{Binding PomodoroAction}" Command="{Binding PomodoroToggleCommand}" />
                <Button Content="跳过" Command="{Binding PomodoroSkipCommand}" />
                <Button Content="重置" Command="{Binding PomodoroResetCommand}" />
              </StackPanel>
              <TextBlock Text="{Binding PomodoroStatus}" Opacity="0.68" />
            </StackPanel>
          </Border>

          <Border Classes="section" IsVisible="{Binding IsSystemMode}">
            <StackPanel Spacing="8">
              <TextBlock Classes="sectionTitle" Text="系统监控" />
              <TextBlock Text="{Binding SystemStatus}" TextWrapping="Wrap" />
              <TextBlock Text="CPU、内存与网络速率会按动态推送周期自动更新。" Opacity="0.62" />
            </StackPanel>
          </Border>

          <Border Classes="section" IsVisible="{Binding IsCustomMode}">
            <StackPanel Spacing="10">
              <TextBlock Classes="sectionTitle" Text="自定义图片" />
              <TextBlock Text="{Binding CustomImageName}" TextWrapping="Wrap" Opacity="0.7" />
              <Button Content="选择图片…" HorizontalAlignment="Left" Click="ChooseImageClick" />
            </StackPanel>
          </Border>

          <Border Classes="section">
            <StackPanel Spacing="10">
              <TextBlock Classes="sectionTitle" Text="键盘连接" />
              <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                <TextBlock Text="图像 API" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding Endpoint}" />
                <TextBlock Grid.Row="1" Text="Codex CLI" VerticalAlignment="Center" IsVisible="{Binding IsCodexMode}" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CodexCliPath}" PlaceholderText="自动检测；也可填写 which codex 的结果" IsVisible="{Binding IsCodexMode}" />
                <TextBlock Grid.Row="2" Text="Codex 刷新" VerticalAlignment="Center" IsVisible="{Binding IsCodexMode}" />
                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding RefreshIntervals}" SelectedItem="{Binding SelectedRefreshInterval}" IsVisible="{Binding IsCodexMode}" />
                <TextBlock Grid.Row="3" Text="动态推送" VerticalAlignment="Center" IsVisible="{Binding IsDynamicMode}" />
                <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding DynamicUploadSeconds}" Minimum="2" Maximum="60" FormatString="0 秒" IsVisible="{Binding IsDynamicMode}" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <Button Content="刷新数据" Command="{Binding RefreshCommand}" />
                <Button Classes="primary" Content="立即推送" Command="{Binding PushCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="section">
            <StackPanel Spacing="10">
              <TextBlock Classes="sectionTitle" Text="屏幕布局" />
              <Grid ColumnDefinitions="110,*,44" RowDefinitions="Auto,Auto" RowSpacing="10">
                <TextBlock Text="顶部安全区" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Grid.ColumnSpan="2" Value="{Binding SafeAreaHeight}" Minimum="44" Maximum="80" FormatString="0 px" />
                <TextBlock Grid.Row="1" Text="JPEG 质量" VerticalAlignment="Center" />
                <Slider Grid.Row="1" Grid.Column="1" Value="{Binding JpegQuality}" Minimum="50" Maximum="100" TickFrequency="1" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding JpegQualityText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
              <CheckBox Content="登录系统时自动启动" IsChecked="{Binding StartWithSystem}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Column="1" HorizontalAlignment="Center">
        <TextBlock Text="键盘预览" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12" />
        <Border Background="#06080D" CornerRadius="8" Padding="10" BoxShadow="0 8 24 0 #40000000">
          <Image Source="{Binding PreviewImage}" Width="142" Height="428" Stretch="Fill" />
        </Border>
        <TextBlock Text="142 × 428 JPEG" HorizontalAlignment="Center" Opacity="0.55" Margin="0,10,0,0" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="2" Padding="24,10" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{Binding LastRefresh}" Opacity="0.58" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastPush}" Opacity="0.58" FontSize="11" />
      </Grid>
    </Border>
  </Grid>
</Window>
